# ==========================================
# VoxLedger AI — Environment Configuration
# ==========================================

# Backend Configuration
PROJECT_NAME="VoxLedger AI"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Connection (SQLite with aiosqlite async driver)
DATABASE_URL="sqlite+aiosqlite:///./voxledger.db"

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# WebSocket & Voice Configuration
WS_HEARTBEAT_INTERVAL=30
VOICE_STREAM_SAMPLE_RATE=16000
VOICE_STREAM_CHANNELS=1

# Gnani AI Configuration (Prisma v3.0 STT & Timbre v3.0 TTS)
# Obtain your X-API-Key-ID from https://api.vachana.ai dashboard
GNANI_API_KEY="your_gnani_api_key_here"
GNANI_STT_MODEL="prisma-v3.0"
GNANI_TTS_MODEL="timbre-v3.0"
GNANI_STT_ENABLED=true
GNANI_TTS_ENABLED=true
GNANI_STT_WS_URL="wss://api.vachana.ai/stt/v3/stream"
GNANI_TTS_API_URL="https://api.vachana.ai/api/v1/tts/inference"
GNANI_TTS_DEFAULT_VOICE="Shivani"
GNANI_DEFAULT_LANGUAGE="hi-IN"
GNANI_TIMEOUT_SECONDS=15.0

# Frontend Configuration (Vite environment variables)
VITE_API_BASE_URL="http://localhost:8000"
VITE_WS_BASE_URL="ws://localhost:8000"
